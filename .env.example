# TexasAgent 环境配置模板
# 复制此文件为 .env 并填入真实值
# .env 文件不会被提交到 Git（已在 .gitignore 中排除）
#
# 也可以将密钥直接填入 model/config.ini（同样已被 gitignore 排除）
# 环境变量优先级高于 config.ini 中的配置

# ===== API 密钥 =====
# 阿里云 DashScope（通义千问）API 密钥
# 获取地址：https://dashscope.console.aliyun.com/apiKey
ALI_API_KEY=your_aliyun_api_key

# DeepSeek API 密钥
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key

# xAI (Grok) API 密钥
# 获取地址：https://console.x.ai/
XAI_API_KEY=your_xai_api_key

# ===== 服务器配置（可选，默认本地模式）=====
# 保持 localhost = 本地模式（推荐，零配置）
POKER_SERVER_DOMAIN=localhost

# 授权验证服务器地址（可选，未配置时以本地模式运行）
POKER_AUTH_URL=

# ===== MySQL 数据库配置（可选）=====
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=poker

# ===== HuggingFace 镜像（中国大陆用户可能需要）=====
HF_ENDPOINT=https://hf-mirror.com
